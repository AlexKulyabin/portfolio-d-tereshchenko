# Настройки Firebase.
#
# Скопируйте этот файл в .env.local и подставьте значения из консоли Firebase:
# Настройки проекта → Ваши приложения → Веб-приложение → Конфигурация SDK.
# Подробная инструкция — в docs/FIREBASE.md.
#
# Эти ключи не являются секретными: они попадают в код сайта и видны всем.
# Доступ к данным ограничивают правила в firestore.rules и storage.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Адрес сайта. Используется, пока он не задан в админке.
VITE_SITE_URL=https://example.ru

# Локальная разработка на эмуляторах Firebase (npm run emulators).
# На боевом сайте должно быть false или отсутствовать.
VITE_USE_EMULATORS=false
