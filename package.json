{
  "name": "portfolio-d-tereshchenko",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content:pull && npm run build:offline",
    "build:offline": "tsc -b && vite build && npm run build:server && node scripts/prerender.mjs && npm run sitemap",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "content:pull": "node scripts/fetch-content.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "emulators": "firebase emulators:start --only auth,firestore,storage"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "lucide-react": "^0.550.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.1.5"
  }
}
